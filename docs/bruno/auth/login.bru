meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "pseudo": "testuser",
    "pin": "1234"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Enregistre automatiquement le token JWT reçu dans la variable d'environnement
  `token`, réutilisée par les requêtes protégées (Authorization: Bearer {{token}}).
}
