PORT=3001

DB_HOST=localhost
DB_NAME=defis_photo
DB_USER=defis_photo
DB_PASS=

# Long random string — never reuse across projects.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call this API.
# https://localhost = app Android (Capacitor), capacitor://localhost = app iOS.
CORS_ORIGINS=http://localhost:5173,https://defis-photo.vercel.app,https://localhost,capacitor://localhost

# Back office AdminJS (/admin). Left empty = disabled.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string (32+ chars) used to sign the admin session cookie.
ADMIN_COOKIE_SECRET=
