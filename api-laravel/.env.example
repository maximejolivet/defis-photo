APP_NAME="Défis Photo API (Laravel)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=defis_photo
DB_USER=defis_photo
DB_PASS=

# Long random string — never reuse across projects (and never reuse the one from
# server-express/server-nest). Generate with: php artisan jwt:secret
JWT_SECRET=change-me
# In minutes (tymon/jwt-auth's native unit) — 43200 = 30 days.
JWT_TTL=43200

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,https://defis-photo.vercel.app

LOG_CHANNEL=stack
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
